# Umgebung und Bauergebnisse
venv
venv-*/

# Suchmodell (rund 100 MB) - kommt ueber werkzeuge/modell_holen.py
ressourcen/modell
dist/
build/
__pycache__/
*.pyc

# Fertige Programmpakete gehören nicht ins Repository.
# GitHub lehnt Dateien über 100 MB ohnehin ab; das DMG wird stattdessen
# als Anhang eines Release veröffentlicht.
*.dmg
*.zip

# Persönliche Daten und Zwischenstände - liegen im Benutzerordner,
# haben im Repository nichts verloren.
index.pkl
config.json
favoriten.json
verlauf.json
lizenz.json

# Protokolle der Hilfsskripte
build_log.txt
test_log.txt
pruef_log.txt
fehlerspeicher.txt
app_ausgabe.txt

# Zum Löschen vorgemerkt
_to_delete/

.DS_Store

# Von wrangler (Cloudflare-Upload) angelegt
.wrangler/

# --- Nicht Teil des Programms: bleibt lokal, gehoert nicht ins Repository ---
# Website (wird per wrangler direkt aus dem Ordner hochgeladen)
website/
# TikTok- und Video-Material
*.mp4
*.mov
*.aiff
*.docx
# ... ausser den erfundenen Testdokumenten, die gehoeren dazu
!tests/testdokumente/**/*.docx
!tests/personendokumente/**/*.docx
STIMME ERZEUGEN.command
lockara-fenster.png
icon_rundlos.png
# Planung, Notizen, alte Staende
release-fahrplan.html
PRODUCT.md
ANLEITUNG.md
angaben_eintragen.py
_vorher/
_update.tar.gz
Lockara Pro.spec
# Lokale Hilfsskripte und Ausgaben
commit_*.command
such-diagnose*.txt

# Uebergabe-Ordner fuer Git-Buendel (Claude-Sitzungen)
_uebergabe/
# Lizenzdateien von Kunden und private Schluessel nie versionieren
*.lockara-lizenz
privat.key
ocr-vergleich/
